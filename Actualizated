-- ===== VARIÁVEIS =====
local playerOriginalSpeed = {}

-- ===== FUNÇÕES DOS COMANDOS =====
local function KillPlayer(player)
    if player and player.Character then
        player.Character:BreakJoints()
        return true
    end
    return false
end

local function FreezePlayer(player)
    if player and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            playerOriginalSpeed[player.Name] = humanoid.WalkSpeed
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            return true
        end
    end
    return false
end

local function UnfreezePlayer(player)
    if player and player.Character then
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = playerOriginalSpeed[player.Name] or 16
            humanoid.JumpPower = 50
            playerOriginalSpeed[player.Name] = nil
            return true
        end
    end
    return false
end

local function KickPlayer(player)
    if player then
        player:Kick("🚫 Kickado pelo Thunder ADM")
        return true
    end
    return false
end

-- ===== SISTEMA DE COMANDOS =====
local function ProcessarComando(mensagem)
    if string.sub(mensagem, 1, 1) == ";" then
        local partes = {}
        for parte in string.gmatch(string.sub(mensagem, 2), "[^%s]+") do
            table.insert(partes, parte)
        end
        
        if #partes >= 2 then
            local comando = partes[1]:lower()
            local nomeAlvo = partes[2]
            
            local targetPlayer = Players:FindFirstChild(nomeAlvo)
            if targetPlayer then
                if comando == "kill" then
                    KillPlayer(targetPlayer)
                elseif comando == "freeze" then
                    FreezePlayer(targetPlayer)
                elseif comando == "unfreeze" then
                    UnfreezePlayer(targetPlayer)
                elseif comando == "kick" then
                    KickPlayer(targetPlayer)
                end
            end
        end
    end
end

